  <!-- ══════════════════════════════════════════════════════════════════
       OfficeCommands — DOIT être au même niveau que AddonUI (sous la
       racine oor:component-data), PAS à l'intérieur de AddonUI.
       C'est ce qui permet aux commandes d'apparaître dans le Customize.
       ══════════════════════════════════════════════════════════════════ -->
  <node oor:name="OfficeCommands">
    <node oor:name="fr.gouv.interieur.mirai.commands" oor:op="replace">
      <node oor:name="UserInterface">
        <node oor:name="Commands">

          <!-- Writer -->
          <node oor:name="EditSelection" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">🖊️ MIrAI : Modifier la sélection</value>
            </prop>
            <prop oor:name="ContextLabel" oor:type="xs:string">
              <value xml:lang="fr">🖊️ Modifier la sélection</value>
            </prop>
          </node>

          <node oor:name="ResizeSelection" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">📏 MIrAI : Ajuster la longueur</value>
            </prop>
          </node>

          <node oor:name="SummarizeSelection" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">📝 MIrAI : Résumer la sélection</value>
            </prop>
          </node>

          <node oor:name="SimplifySelection" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">💬 MIrAI : Reformuler la sélection</value>
            </prop>
          </node>

          <!-- Calc -->
          <node oor:name="TransformToColumn" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">🔄 MIrAI : Transformer → colonne résultat</value>
            </prop>
          </node>

          <node oor:name="GenerateFormula" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">🧮 MIrAI : Générer une formule</value>
            </prop>
          </node>

          <node oor:name="AnalyzeRange" oor:op="replace">
            <prop oor:name="Label" oor:type="xs:string">
              <value xml:lang="fr">📊 MIrAI : Analyser la plage</value>
            </prop>
          </node>

        </node>
      </node>
    </node>
  </node>

</oor:component-data>